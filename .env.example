NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/turmeric_dashboard?schema=public
GOOGLE_SHEETS_MASTER_SPREADSHEET_ID=your_master_google_sheet_id
GOOGLE_SHEETS_MASTER_SUPPLIERS_RANGE=Suppliers!A:Z
GOOGLE_SHEETS_MASTER_BUYERS_RANGE=Buyers!A:Z
GOOGLE_SHEETS_MASTER_EXPORTERS_RANGE=Export!A:Z
GOOGLE_SHEETS_SOURCE_SUPPLIERS_SPREADSHEET_ID=your_source_supplier_sheet_id
GOOGLE_SHEETS_SOURCE_SUPPLIERS_RANGE=Suppliers!A:Z
GOOGLE_SHEETS_SOURCE_BUYERS_SPREADSHEET_ID=your_source_buyer_sheet_id
GOOGLE_SHEETS_SOURCE_BUYERS_RANGE=Buyers!A:Z
GOOGLE_SHEETS_SOURCE_EXPORTERS_SPREADSHEET_ID=your_source_export_sheet_id
GOOGLE_SHEETS_SOURCE_EXPORTERS_RANGE=Export!A:Z
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_POLL_INTERVAL_MS=15000
DEFAULT_PAGE_SIZE=20
MATCH_MIN_SCORE=60
